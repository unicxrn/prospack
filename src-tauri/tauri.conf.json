{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prospack",
  "version": "0.1.0",
  "identifier": "io.github.unicxrn.prospack",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1430",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Prospack",
        "width": 1320,
        "height": 860,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": []
  },
  "mainBinaryName": "prospack"
}
